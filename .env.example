# =============================================================================
# FactorNexus 环境变量模板
# 使用方法：
#   1. 复制本文件为 .env：  cp .env.example .env   （Windows: copy .env.example .env）
#   2. 填入你的密钥后保存
# 说明：.env 已在 .gitignore 中，不会被提交；本模板可安全提交。
# =============================================================================

# DeepSeek API Key（LLM 引擎批级真挖掘）
# 缺省时 LLM 引擎自动降级为规则化挖掘（流程不受影响，仅少 LLM 假设注入）
DEEPSEEK_API_KEY=
